<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Input methods cannot use App Sandbox due to IMKit mach port IPC incompatibility -->
    <key>com.apple.security.app-sandbox</key>
    <false/>
    <!-- Network access for Groq and Gemini API calls -->
    <key>com.apple.security.network.client</key>
    <true/>
    <!-- Microphone access for voice transcription (Hardened Runtime, non-sandboxed) -->
    <!-- com.apple.security.device.audio-input is required for non-sandboxed apps with Hardened Runtime -->
    <!-- com.apple.security.device.microphone is only for App Sandbox apps -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <!-- Load the bundled sherpa-onnx dylibs under Hardened Runtime. -->
    <!-- Library validation demands that every loaded dylib carry the SAME Team ID -->
    <!-- as the main executable. This app is signed with a self-signed certificate, -->
    <!-- which has no Team ID at all, so the check compares "nothing" against -->
    <!-- "nothing" and rejects the load: -->
    <!--   Library not loaded: @rpath/libsherpa-onnx-c-api.dylib -->
    <!--   ... mapping process and mapped file (non-platform) have different Team IDs -->
    <!-- The app then dies in dyld before main(). Turning library validation off is -->
    <!-- the supported escape for non-notarized apps that ship their own libraries; -->
    <!-- the alternative is a paid Developer ID, which this project deliberately -->
    <!-- avoids. Scope is narrow — the dylibs live inside the signed bundle and are -->
    <!-- re-signed with the app on every build (see install.sh / package-release.sh). -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
